  "item": [
    {
      "name": "V2 (Industrial Engine)",
      "item": [
        {
          "name": "Start Industrial Job",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v2/crawler/jobs/DailyAnalysis/5"
          }
        },
        {
          "name": "Check Report Existence (Deterministic)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v2/crawler/check/DailyAnalysis/2026-01-23"
          }
        },
        {
          "name": "Stream Job Events",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v2/crawler/stream/{{jobId}}"
          }
        }
      ]
    },
    {
      "name": "V1 (Standard & Legacy)",
      "item": [
        {
          "name": "Sync Extract (Blocking)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/crawler/extract/DailyAnalysis/2"
          }
        },
        {
          "name": "Check Feed for New Content",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/crawler/check/DailyAnalysis"
          }
        },
        {
          "name": "Start Legacy Async Job",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/crawler/async/extract/DailyAnalysis/5"
          }
        },
        {
          "name": "Get Legacy Job Status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/crawler/async/status/{{jobId}}"
          }
        }
      ]
    },
