						],
						"url": {
							"raw": "{{baseUrl}}/api/v2/crawler/stream/:jobId",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v2",
								"crawler",
								"stream",
								":jobId"
							],
							"variable": [
								{
									"key": "jobId",
									"value": "",
									"description": "UUID of the job returned by Start Extraction"
								}
							]
						},
						"description": "Connect to this endpoint to receive real-time updates for a running job."
					},
					"response": []
				},
				{
					"name": "Check Report Existence",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v2/crawler/check/:seccion/:date",
