	},
	"item": [
		{
			"name": "Pipeline (Orchestrator)",
			"description": "End-to-end automation triggers.",
			"item": [
				{
					"name": "Run Full Pipeline (Daily)",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v2/pipeline/run/:date",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v2",
								"pipeline",
								"run",
								":date"
							],
							"variable": [
								{
									"key": "date",
									"value": "2026-01-28",
									"description": "Date to process (YYYY-MM-DD)"
								}
							]
						},
						"description": "Triggers the full flow: 1. Checks/Downloads reports from Crawler. 2. Sends content to Gemini for analysis. 3. Persists JSONs to DB. 4. Generates Markdown report."
					},
					"response": []
				}
			]
		},
		{
			"name": "Crawler V2 (Industrial)",
			"description": "New generation crawler endpoints with async jobs and SSE.",
			"item": [
				{
					"name": "Start Extraction Job",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v2/crawler/jobs/:seccion/:dias",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v2",
								"crawler",
								"jobs",
								":seccion",
								":dias"
							],
							"variable": [
								{
									"key": "seccion",
									"value": "DailyAnalysis",
									"description": "DailyAnalysis or QuantUpdates"
								},
								{
									"key": "dias",
									"value": "1",
									"description": "Number of days to look back"
								}
							]
						},
						"description": "Starts an asynchronous background job for extraction."
					},
					"response": []
				},
				{
					"name": "Stream Job Events (SSE)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "text/event-stream",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v2/crawler/stream/:jobId",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v2",
								"crawler",
								"stream",
								":jobId"
							],
							"variable": [
								{
									"key": "jobId",
									"value": "",
									"description": "UUID of the job returned by Start Extraction"
								}
							]
						},
						"description": "Connect to this endpoint to receive real-time updates for a running job."
					},
					"response": []
				},
				{
					"name": "Check Report Existence",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v2/crawler/check/:seccion/:date",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v2",
								"crawler",
								"check",
								":seccion",
								":date"
							],
							"variable": [
								{
									"key": "seccion",
									"value": "DailyAnalysis"
								},
								{
									"key": "date",
									"value": "2026-01-28"
								}
							]
						},
						"description": "Deterministically checks if a report exists for a specific date."
					},
					"response": []
				}
			]
		},
